# ── Backend (Go) ────────────────────────────────────────────────────
# LLM key for grounded response generation (either name works).
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=

# Storage. Default JSON GraphStore writes to ./data.
STORE_PATH=./data
# STORE_ENGINE=objectbox      # optional; requires the objectbox build tag

# HTTP port (default 8080).
PORT=8080

# ── Frontend (React + Vite) ─────────────────────────────────────────
# Override the API base the UI talks to (default http://localhost:8080).
VITE_API_BASE=http://localhost:8080
